# ------------------------------------------------------------------------------
pdf_path <- file.path(cross_sample_dir, "ASPC_vs_NE_continuous_regression.pdf")
pdf(pdf_path, width = 14, height = 10, useDingbats = FALSE)

set.seed(LABEL_SEED)
print(p1)

## clean, label-free version of the same panel
print(p1 %+% ps_cancer +
        list(labs(caption = paste0(
          if (SHOW_BPH_REFERENCE) "Open green triangles: BPH, reference only. "
          else "Benign (BPH) samples excluded. ",
          "Unlabelled version; sample identities in per_sample_continuous_metrics.csv."))) )

print((p2 | p3) / (p4 | p5) +
        plot_annotation(title = "Robustness of the continuous ASPC-NE association (cancer samples only)",
                        theme = theme(plot.title = element_text(face = "bold"))))

print(p6 + labs(subtitle = "Dashed lines: +/-20% change"))

grid::grid.newpage()
gridExtra::grid.table(
  res %>% mutate(across(where(is.numeric), ~signif(.x, 3))) %>%
